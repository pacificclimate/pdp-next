{
  "name": "pdp-next",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && python3 -m unittest portal_meta_builder.test_metadata",
    "test:coverage": "vitest run --coverage --coverage.reporter=text && python3 -m unittest portal_meta_builder.test_metadata",
    "test:watch": "vitest",
    "lint": "eslint 'viewer/js/**/*.js' 'viewer/js/*.js'",
    "lint:fix": "eslint --fix 'viewer/js/**/*.js' 'viewer/js/*.js'",
    "lint:ci": "eslint --max-warnings=999 'viewer/js/**/*.js' 'viewer/js/*.js'"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ol": "10.6.1",
    "proj4": "2.11.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  }
}
